rules_version = '2';
// Acesso por conta (e-mail e senha). Só entra quem tem acessos/<uid>, criado por um administrador.
//  nivel "master" (único, equipe@): como admin, mas fixo; "admin": gerencia acessos; "usuario" (Convidado): usa o sistema.
// A pessoa só pode alterar no próprio registro: trocarSenha (para false), ultimoAcesso e nome.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function ativo() { return logado() && exists(/databases/$(database)/documents/acessos/$(request.auth.uid)); }
    // convidado (nivel "usuario"): só RFI. Equipe (admin/master): todo o resto.
    function interno() { return admin(); }
    function admin() { return ativo() && get(/databases/$(database)/documents/acessos/$(request.auth.uid)).data.nivel in ['admin', 'master']; }

    // a conta Master (equipe@fj.arq.br) é única: só se define pela configuração inicial e não pode ser removida nem rebaixada
    match /acessos/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow delete: if admin() && resource.data.nivel != 'master';
      // admin cria; ou a própria pessoa, a partir de uma liberação em acessosPendentes/<email> (conta que já existia)
      allow create: if (admin() && request.resource.data.nivel != 'master')
        || (logado() && request.auth.uid == uid
            && exists(/databases/$(database)/documents/acessosPendentes/$(request.auth.token.email.lower()))
            && request.resource.data.nivel == get(/databases/$(database)/documents/acessosPendentes/$(request.auth.token.email.lower())).data.nivel
            && request.resource.data.nivel in ['admin', 'usuario']
            && request.resource.data.email == request.auth.token.email.lower());
      allow update: if (admin() && request.resource.data.nivel == resource.data.nivel)
        || (admin() && resource.data.nivel != 'master' && request.resource.data.nivel in ['admin', 'usuario'])
        || (logado() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trocarSenha', 'ultimoAcesso', 'nome'])
            && request.resource.data.get('trocarSenha', false) == false);
    }
    match /acessosPendentes/{em} {
      allow read: if admin() || (logado() && em == request.auth.token.email.lower());
      allow create, update: if admin() && request.resource.data.nivel in ['admin', 'usuario'];
      allow delete: if admin() || (logado() && em == request.auth.token.email.lower());
    }
    // senha provisória (para reenviar a mensagem enquanto a pessoa não entrou); apagada no 1º acesso
    match /senhasProvisorias/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow write: if admin();
      allow delete: if logado() && request.auth.uid == uid;
    }
    // RFI: a equipe vê todas. Convidado só vê RFIs de projetos de que participa (rfi.participantes, copiado do projeto),
    // comenta em qualquer uma e responde (respostas/status) só às dirigidas a ele ou à empresa dele.
    function participa() { return ativo() && request.auth.uid in resource.data.get('participantes', []); }
    function minhaEmpresa() { return get(/databases/$(database)/documents/acessos/$(request.auth.uid)).data.get('empresa', '-'); }
    function dirigida() {
      return ('u:' + request.auth.uid) in resource.data.get('requeridosIds', [])
        || ('e:' + minhaEmpresa()) in resource.data.get('requeridosIds', [])
        || (resource.data.get('requerido', null) != null && (   // RFIs antigas, com um só requerido
          (resource.data.requerido.get('tipo', '') == 'u' && resource.data.requerido.get('id', '') == request.auth.uid)
          || (resource.data.requerido.get('tipo', '') == 'e' && resource.data.requerido.get('id', '') == minhaEmpresa())));
    }
    function muda(chaves) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(chaves); }
    function projRfi(pid) { return get(/databases/$(database)/documents/projetosRfi/$(pid)).data; }
    // convidado cria RFI em projeto de que participa, como requerente, com a lista de participantes do projeto
    function criaConvidado() {
      return ativo() && request.auth.uid in projRfi(request.resource.data.projeto).get('participantes', [])
        && request.resource.data.get('participantes', []) == projRfi(request.resource.data.projeto).get('participantes', [])
        && request.resource.data.get('requerente', {}).get('tipo', '') == 'u'
        && request.resource.data.get('requerente', {}).get('id', '') == request.auth.uid;
    }
    function master() { return ativo() && get(/databases/$(database)/documents/acessos/$(request.auth.uid)).data.nivel == 'master'; }
    // autor da RFI = autorId (quem abriu); nas RFIs antigas, sem autorId, o requerente quando é uma pessoa
    function souAutor() {
      return resource.data.get('autorId', '') == request.auth.uid
        || (resource.data.get('autorId', '') == '' && resource.data.get('requerente', {}).get('tipo', '') == 'u'
            && resource.data.get('requerente', {}).get('id', '') == request.auth.uid);
    }
    function mantemAutor() {
      return request.resource.data.get('autorId', '') == resource.data.get('autorId', '')
        || (resource.data.get('autorId', '') == '' && request.resource.data.get('autorId', '') == request.auth.uid);
    }
    // histórico: só acrescenta (o que já estava gravado não muda)
    function hist(d) { return d.get('historico', []); }
    function histOk() {
      return hist(request.resource.data).size() >= hist(resource.data).size()
        && hist(request.resource.data)[0:hist(resource.data).size()] == hist(resource.data);
    }
    function mudouStatusParaRespondida() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status == 'RESPONDIDA';
    }
    // RFI: só o autor altera os dados ou exclui; o Master faz tudo. Os demais (equipe ou convidados participantes) comentam;
    // respondem a equipe e os requeridos; o status, qualquer administrador. Cada resposta ou comentário só é alterado por quem escreveu (controle feito pelo sistema).
    match /rfi/{id} {
      allow read: if interno() || participa();
      allow create: if master() || ((interno() || criaConvidado()) && request.resource.data.get('autorId', '') == request.auth.uid);
      allow delete: if master() || ((interno() || participa()) && souAutor());
      allow update: if master()
        || (interno() && souAutor() && mantemAutor() && histOk() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['projeto']))
        || (participa() && souAutor() && mantemAutor() && histOk()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['projeto', 'participantes', 'requerente']))
        || (interno() && muda(['participantes']))                                            // sincronização com a equipe do projeto
        || (interno() && muda(['requerente', 'requeridos', 'requeridosIds', 'requerido']))  // ativação de pessoa cadastrada sem acesso
        || (interno() && histOk() && muda(['notificacoes', 'historico']))
        || ((interno() || participa()) && histOk() && muda(['comentarios', 'historico', 'atualizadoEm', 'atualizadoPor']))
        || (interno() && histOk() && muda(['comentarios', 'respostas', 'status', 'historico', 'atualizadoEm', 'atualizadoPor']))  // status: qualquer administrador
        || (participa() && dirigida() && histOk() && mudouStatusParaRespondida()
            && muda(['comentarios', 'respostas', 'status', 'historico', 'atualizadoEm', 'atualizadoPor']));
    }
    match /projetosRfi/{id} {
      allow read: if interno() || participa();
      allow write: if interno();
    }
    // demais coleções: só a equipe (o curinga também casaria com as coleções acima, por isso a exclusão explícita)
    match /{colecao}/{resto=**} {
      allow read, write: if interno() && !(colecao in ['acessos', 'acessosPendentes', 'senhasProvisorias', 'rfi', 'projetosRfi']);
    }
  }
}
