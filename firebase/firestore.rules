rules_version = '2';
// Entra quem fez login com link no e-mail (e-mail confirmado):
//  - endereços @fj.arq.br: sempre, com edição;
//  - outros: só se houver convites/<email>; papel "editar" grava, "consultar" só lê.
// Só @fj.arq.br altera a lista de convites.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function confirmado() { return request.auth != null && request.auth.token.email_verified == true; }
    function interno() { return confirmado() && email().matches('.*@fj[.]arq[.]br$'); }
    function convite() { return get(/databases/$(database)/documents/convites/$(email())).data; }
    function convidado() { return confirmado() && exists(/databases/$(database)/documents/convites/$(email())); }
    function editor() { return interno() || (convidado() && convite().papel == 'editar'); }

    match /convites/{em} {
      allow read: if interno() || (confirmado() && em == email());
      allow write: if interno();
    }
    match /usuarios/{uid} {
      allow read: if interno() || convidado();
      allow write: if (interno() || convidado()) && request.auth.uid == uid;
    }
    match /{documento=**} {
      allow read: if interno() || convidado();
      allow write: if editor();
    }
  }
}
