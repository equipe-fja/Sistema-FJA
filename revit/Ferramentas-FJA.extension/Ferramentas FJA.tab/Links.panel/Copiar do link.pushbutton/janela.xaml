<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copiar do link — Ferramentas FJA" Width="1180" Height="760" MinWidth="940" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#F6F6F5" Foreground="#1D1D1D">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E2DF" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" BorderBrush="#C9C9C5" BorderThickness="1" Background="White" VerticalAlignment="Center">
                    <TextBlock Text="FJ" FontFamily="Arial" FontWeight="Bold" FontSize="15" Foreground="#8E1B1B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Copiar do link" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtInfo" Foreground="#5E5E5C" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Link" Style="{DynamicResource Rotulo}"/>
                    <ComboBox x:Name="cbLink" Width="340" SelectionChanged="link_mudou"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Módulo" Style="{DynamicResource Rotulo}"/>
                    <ComboBox x:Name="cbModulo" Width="190" SelectionChanged="modulo_mudou"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- filtros -->
        <Grid Grid.Row="1" Margin="18,12,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="tbBusca" TextChanged="filtro_mudou" ToolTip="Categoria, família, tipo ou nível"/>
            <ComboBox x:Name="cbCat" Grid.Column="1" Width="210" Margin="8,0,0,0" SelectionChanged="filtro_mudou"/>
            <ComboBox x:Name="cbNivel" Grid.Column="2" Width="170" Margin="8,0,0,0" SelectionChanged="filtro_mudou"/>
            <ComboBox x:Name="cbEstado" Grid.Column="3" Width="200" Margin="8,0,0,0" SelectionChanged="filtro_mudou"/>
            <TextBlock x:Name="txtResumo" Grid.Column="4" Foreground="#5E5E5C" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
            <Button x:Name="btLimparEscolha" Grid.Column="5" Content="Limpar escolha no modelo" Padding="12,0" Style="{DynamicResource Discreto}" Visibility="Collapsed" Click="limpar_escolha"/>
        </Grid>

        <Border Grid.Row="2" Margin="18,10,18,8" Style="{DynamicResource Cartao}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="gCab" Margin="8,4,8,6"/>
                <ListBox x:Name="lbItens" Grid.Row="1" SelectionMode="Extended" SelectionChanged="sel_mudou" BorderThickness="0"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#E2E2DF" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="spWorkset" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Workset" Foreground="#5E5E5C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cbWorkset" Width="220"/>
                </StackPanel>
                <TextBlock x:Name="txtRodape" Grid.Column="1" Foreground="#5E5E5C" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Content="Escolher no modelo…" Margin="0,0,8,0" Padding="12,0" ToolTip="Selecionar elementos do link na vista (a janela fecha e volta)" Click="escolher"/>
                <Button x:Name="btCopiar" Grid.Column="3" Content="Copiar" Margin="0,0,8,0" Padding="14,0" Style="{DynamicResource Primario}" IsEnabled="False" Click="copiar"/>
                <Button Grid.Column="4" Content="Fechar" Padding="16,0" Style="{DynamicResource Discreto}" Click="fechar"/>
            </Grid>
        </Border>
    </Grid>
</Window>
