<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova composição na biblioteca — Ferramentas FJA" Width="820" Height="700" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12.5" Background="#FBFBFA">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Nova composição na biblioteca central" FontSize="17" FontWeight="SemiBold" Foreground="#1D1D1D"/>
            <TextBlock x:Name="txtSub" Foreground="#5E5E5C" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="O item é criado no sistema (biblioteca central e especificação do projeto) e o tipo é criado no modelo agora mesmo."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Sigla (composição)" Foreground="#5E5E5C"/>
                <ComboBox x:Name="cbSigla" SelectionChanged="sigla_mudou"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Categoria do Revit" Foreground="#5E5E5C"/>
                <ComboBox x:Name="cbCat" SelectionChanged="atualizar">
                    <ComboBoxItem Content="Parede"/>
                    <ComboBoxItem Content="Piso"/>
                    <ComboBoxItem Content="Forro"/>
                    <ComboBoxItem Content="Cobertura"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Papel" Foreground="#5E5E5C"/>
                <ComboBox x:Name="cbPapel" SelectionChanged="atualizar">
                    <ComboBoxItem Content="Vedação"/>
                    <ComboBoxItem Content="Acabamento"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Margin="0,8,0,0">
                <TextBlock Text="Descrição" Foreground="#5E5E5C"/>
                <TextBox x:Name="tbDesc" Height="24" TextChanged="atualizar"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="6" Margin="0,8,0,0">
                <TextBlock Text="Especificação (texto)" Foreground="#5E5E5C"/>
                <TextBox x:Name="tbTexto" Height="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Margin="0,10,0,0" BorderBrush="#E2E2DF" BorderThickness="1" Background="White" CornerRadius="4" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Camadas" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtOrdem" Foreground="#8F8F8C" Margin="8,0,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="spCamadas"/>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="+ Adicionar camada" Padding="10,3" Click="adicionar"/>
                    <TextBlock x:Name="txtTotal" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="txtPrevia" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#5E5E5C"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" Width="90" Height="28" Click="cancelar"/>
            <Button x:Name="btOk" Content="Criar na biblioteca e no modelo" MinWidth="210" Height="28" Margin="8,0,0,0"
                    Click="confirmar" Background="#8E1B1B" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
