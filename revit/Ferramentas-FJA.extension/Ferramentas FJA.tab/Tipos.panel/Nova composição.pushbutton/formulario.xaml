<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Composição — Ferramentas FJA" Width="900" Height="740" MinWidth="740" MinHeight="580"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="#F6F6F5" Foreground="#1D1D1D">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E2DF" BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel>
                <TextBlock x:Name="txtTitulo" Text="Nova composição na biblioteca central" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="txtSub" Foreground="#5E5E5C" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="18,14,18,0" Style="{DynamicResource Cartao}" Background="White" BorderBrush="#E2E2DF" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Sigla (composição)" Style="{DynamicResource Rotulo}"/>
                    <ComboBox x:Name="cbSigla" SelectionChanged="sigla_mudou"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Categoria do Revit" Style="{DynamicResource Rotulo}"/>
                    <ComboBox x:Name="cbCat" SelectionChanged="atualizar">
                        <ComboBoxItem Content="Parede"/>
                        <ComboBoxItem Content="Piso"/>
                        <ComboBoxItem Content="Forro"/>
                        <ComboBoxItem Content="Cobertura"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Papel" Style="{DynamicResource Rotulo}"/>
                    <ComboBox x:Name="cbPapel" SelectionChanged="atualizar">
                        <ComboBoxItem Content="Vedação"/>
                        <ComboBoxItem Content="Acabamento"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Margin="0,10,0,0">
                    <TextBlock Text="Descrição" Style="{DynamicResource Rotulo}"/>
                    <TextBox x:Name="tbDesc" TextChanged="atualizar"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="6" Margin="0,10,0,0">
                    <TextBlock Text="Especificação (opcional)" Style="{DynamicResource Rotulo}"/>
                    <TextBox x:Name="tbTexto" Height="64" Padding="8,6" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="18,12,18,0" Style="{DynamicResource Cartao}" Background="White" BorderBrush="#E2E2DF" BorderThickness="1" CornerRadius="8" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Camadas" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="txtOrdem" Foreground="#8F8F8C" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="76"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Função" Style="{DynamicResource Rotulo}"/>
                    <TextBlock Grid.Column="2" Text="Material (digite para buscar)" Style="{DynamicResource Rotulo}"/>
                    <TextBlock Grid.Column="3" Text="Esp. (mm)" Style="{DynamicResource Rotulo}"/>
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="spCamadas"/>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="+  Adicionar camada" Click="adicionar"/>
                    <TextBlock x:Name="txtTotal" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="txtPrevia" Grid.Row="3" Margin="18,10,18,0" TextWrapping="Wrap" Foreground="#5E5E5C"/>

        <Border Grid.Row="4" Margin="0,12,0,0" Background="White" BorderBrush="#E2E2DF" BorderThickness="0,1,0,0" Padding="18,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" MinWidth="90" Click="cancelar"/>
                <Button x:Name="btOk" Content="Criar na biblioteca e no modelo" MinWidth="220" Margin="8,0,0,0"
                        Click="confirmar" Style="{DynamicResource Primario}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
