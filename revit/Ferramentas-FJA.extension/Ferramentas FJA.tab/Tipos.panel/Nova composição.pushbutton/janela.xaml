<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova composição — Ferramentas FJA" Width="1120" Height="720" MinWidth="880" MinHeight="540"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#F6F6F5" Foreground="#1D1D1D">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- cabeçalho no padrão do sistema: marca FJ + título -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E2DF" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" BorderBrush="#C9C9C5" BorderThickness="1" Background="White" VerticalAlignment="Center">
                    <TextBlock Text="FJ" FontFamily="Arial" FontWeight="Bold" FontSize="15" Foreground="#8E1B1B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Nova composição" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtFonte" Foreground="#5E5E5C" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Projeto" Style="{DynamicResource Rotulo}"/>
                    <ComboBox x:Name="cbProjeto" Width="280" SelectionChanged="projeto_mudou"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Dados do sistema" Style="{DynamicResource Rotulo}"/>
                    <ComboBox x:Name="cbFonte" Width="160" SelectionChanged="fonte_mudou">
                        <ComboBoxItem Content="Oficial"/>
                        <ComboBoxItem Content="Desenvolvimento"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- filtros -->
        <WrapPanel Grid.Row="1" Margin="18,14,18,10">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Buscar" Style="{DynamicResource Rotulo}"/>
                <TextBox x:Name="tbBusca" Width="320" TextChanged="filtro_mudou" ToolTip="FJ, keynote, sigla, descrição ou material"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Categoria do Revit" Style="{DynamicResource Rotulo}"/>
                <ComboBox x:Name="cbCategoria" Width="140" SelectionChanged="filtro_mudou">
                    <ComboBoxItem Content="Todas"/>
                    <ComboBoxItem Content="Parede"/>
                    <ComboBoxItem Content="Piso"/>
                    <ComboBoxItem Content="Forro"/>
                    <ComboBoxItem Content="Cobertura"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Papel" Style="{DynamicResource Rotulo}"/>
                <ComboBox x:Name="cbPapel" Width="130" SelectionChanged="filtro_mudou">
                    <ComboBoxItem Content="Todos"/>
                    <ComboBoxItem Content="Vedação"/>
                    <ComboBoxItem Content="Acabamento"/>
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="ckProjeto" Content="Só os que estão no projeto" VerticalAlignment="Bottom" Margin="0,0,0,8" Checked="filtro_mudou" Unchecked="filtro_mudou"/>
        </WrapPanel>

        <!-- lista + detalhe -->
        <Grid Grid.Row="2" Margin="18,0,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{DynamicResource Cartao}" Background="White" BorderBrush="#E2E2DF" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#FBFBFA" BorderBrush="#E2E2DF" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="10,8">
                        <Grid x:Name="gCab"/>
                    </Border>
                    <ListBox x:Name="lbItens" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="item_mudou"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource Cartao}" Background="White" BorderBrush="#E2E2DF" BorderThickness="1" CornerRadius="8" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="spDetalhe">
                            <TextBlock Text="Escolha uma composição na lista." Foreground="#8F8F8C"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="btEditar" Content="Editar composição…" IsEnabled="False" Click="editar"
                                ToolTip="Altera camadas, descrição e especificação no sistema e atualiza o tipo no modelo"/>
                        <Button x:Name="btDuplicar" Content="Duplicar como nova…" Margin="8,0,0,0" IsEnabled="False" Click="duplicar"
                                ToolTip="Abre uma composição nova já preenchida com as camadas desta"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- rodapé -->
        <Border Grid.Row="3" Margin="0,14,0,0" Background="White" BorderBrush="#E2E2DF" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btNova" Grid.Column="0" Content="+  Nova composição…" Margin="0,0,14,0" Click="nova"
                        ToolTip="Cria uma composição nova na biblioteca central do sistema e o tipo no modelo"/>
                <TextBlock x:Name="txtRodape" Grid.Column="1" Foreground="#5E5E5C" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Name="btFechar" Grid.Column="2" Content="Fechar" MinWidth="90" Margin="8,0,0,0" Click="fechar"/>
                <Button x:Name="btCriar" Grid.Column="3" Content="Criar no modelo" MinWidth="170" Margin="8,0,0,0"
                        IsEnabled="False" Click="criar" Style="{DynamicResource Primario}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
