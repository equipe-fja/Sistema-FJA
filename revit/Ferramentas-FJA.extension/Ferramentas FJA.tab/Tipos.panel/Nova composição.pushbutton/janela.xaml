<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova composição — Ferramentas FJA" Width="1080" Height="680" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12.5" Background="#FBFBFA">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Nova composição" FontSize="18" FontWeight="SemiBold" Foreground="#1D1D1D"/>
                <TextBlock x:Name="txtFonte" Foreground="#5E5E5C" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom">
                <TextBlock Text="Projeto" Foreground="#5E5E5C"/>
                <ComboBox x:Name="cbProjeto" Width="260" SelectionChanged="projeto_mudou"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Bottom">
                <TextBlock Text="Dados do sistema" Foreground="#5E5E5C"/>
                <ComboBox x:Name="cbFonte" Width="150" SelectionChanged="fonte_mudou">
                    <ComboBoxItem Content="Oficial"/>
                    <ComboBoxItem Content="Desenvolvimento"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- filtros -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Categoria do Revit" Foreground="#5E5E5C"/>
                <ComboBox x:Name="cbCategoria" Width="130" SelectionChanged="filtro_mudou">
                    <ComboBoxItem Content="Todas"/>
                    <ComboBoxItem Content="Parede"/>
                    <ComboBoxItem Content="Piso"/>
                    <ComboBoxItem Content="Forro"/>
                    <ComboBoxItem Content="Cobertura"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Papel" Foreground="#5E5E5C"/>
                <ComboBox x:Name="cbPapel" Width="120" SelectionChanged="filtro_mudou">
                    <ComboBoxItem Content="Todos"/>
                    <ComboBoxItem Content="Vedação"/>
                    <ComboBoxItem Content="Acabamento"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Buscar" Foreground="#5E5E5C"/>
                <TextBox x:Name="tbBusca" Width="300" Height="23" TextChanged="filtro_mudou" ToolTip="FJ, keynote, descrição, material"/>
            </StackPanel>
            <CheckBox x:Name="ckProjeto" Content="Só os que estão no projeto" VerticalAlignment="Bottom" Margin="0,0,0,4" Checked="filtro_mudou" Unchecked="filtro_mudou"/>
        </WrapPanel>

        <!-- lista + detalhe -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#E2E2DF" BorderThickness="1" Background="White" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="gCab" Grid.Row="0" Margin="8,6,8,6"/>
                    <ListBox x:Name="lbItens" Grid.Row="1" BorderThickness="0" SelectionChanged="item_mudou"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" BorderBrush="#E2E2DF" BorderThickness="1" Background="White" CornerRadius="4" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="spDetalhe">
                        <TextBlock Text="Escolha uma composição na lista." Foreground="#8F8F8C"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- rodapé -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="txtRodape" Grid.Column="0" Foreground="#5E5E5C" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="btFechar" Grid.Column="1" Content="Fechar" Width="90" Height="28" Margin="8,0,0,0" Click="fechar"/>
            <Button x:Name="btCriar" Grid.Column="2" Content="Criar no modelo" MinWidth="150" Height="28" Margin="8,0,0,0"
                    IsEnabled="False" Click="criar" Background="#8E1B1B" Foreground="White" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
