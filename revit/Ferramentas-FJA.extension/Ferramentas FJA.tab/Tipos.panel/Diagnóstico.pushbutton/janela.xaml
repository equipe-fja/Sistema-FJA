<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnóstico — Ferramentas FJA" Width="1240" Height="780" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#F6F6F5" Foreground="#1D1D1D">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E2DF" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" BorderBrush="#C9C9C5" BorderThickness="1" Background="White" VerticalAlignment="Center">
                    <TextBlock Text="FJ" FontFamily="Arial" FontWeight="Bold" FontSize="15" Foreground="#8E1B1B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Diagnóstico" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtFonte" Foreground="#5E5E5C" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Projeto" Style="{DynamicResource Rotulo}"/>
                    <ComboBox x:Name="cbProjeto" Width="280" SelectionChanged="projeto_mudou"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Dados do sistema" Style="{DynamicResource Rotulo}"/>
                    <ComboBox x:Name="cbFonte" Width="160" SelectionChanged="fonte_mudou">
                        <ComboBoxItem Content="Oficial"/>
                        <ComboBoxItem Content="Desenvolvimento"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- filtros -->
        <Grid Grid.Row="1" Margin="18,12,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="tbBusca" TextChanged="filtro_mudou" ToolTip="Nome, FJ, keynote ou descrição"/>
            <ComboBox x:Name="cbEstado" Grid.Column="1" Width="230" Margin="8,0,0,0" SelectionChanged="filtro_mudou"/>
            <ComboBox x:Name="cbCat" Grid.Column="2" Width="200" Margin="8,0,0,0" SelectionChanged="filtro_mudou"/>
            <TextBlock x:Name="txtResumo" Grid.Column="3" Foreground="#5E5E5C" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
        </Grid>

        <Grid Grid.Row="2" Margin="18,10,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource Cartao}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="gCab" Margin="8,4,8,6"/>
                    <ListBox x:Name="lbItens" Grid.Row="1" SelectionMode="Extended" SelectionChanged="sel_mudou" BorderThickness="0"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource Cartao}" Padding="16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="spDetalhe"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="#E2E2DF" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ckRenomear" Content="Renomear os tipos (KEYNOTE - DESCRIÇÃO)" VerticalAlignment="Center" IsChecked="False"/>
                <TextBlock x:Name="txtRodape" Grid.Column="1" Foreground="#5E5E5C" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                <Button x:Name="btMostrar" Grid.Column="2" Content="Mostrar no modelo" Margin="0,0,8,0" Padding="12,0" Style="{DynamicResource Discreto}" IsEnabled="False" Click="mostrar_modelo"/>
                <Button x:Name="btIncluir" Grid.Column="3" Content="Incluir no projeto" Margin="0,0,8,0" Padding="12,0" IsEnabled="False" Click="incluir"/>
                <Button x:Name="btDesvincular" Grid.Column="4" Content="Desvincular" Margin="0,0,8,0" Padding="12,0" IsEnabled="False" Click="desvincular"/>
                <Button x:Name="btResinc" Grid.Column="5" Content="Ressincronizar selecionados" Margin="0,0,8,0" Padding="14,0" Style="{DynamicResource Primario}" IsEnabled="False" Click="ressincronizar"/>
                <Button Grid.Column="6" Content="Fechar" Padding="16,0" Style="{DynamicResource Discreto}" Click="fechar"/>
            </Grid>
        </Border>
    </Grid>
</Window>
