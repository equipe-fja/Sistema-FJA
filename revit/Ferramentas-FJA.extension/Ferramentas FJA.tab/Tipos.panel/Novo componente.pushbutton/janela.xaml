<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Componentes — Ferramentas FJA" Width="1180" Height="780" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#F6F6F5" Foreground="#1D1D1D">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- cabeçalho no padrão do sistema -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E2DF" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" BorderBrush="#C9C9C5" BorderThickness="1" Background="White" VerticalAlignment="Center">
                    <TextBlock Text="FJ" FontFamily="Arial" FontWeight="Bold" FontSize="15" Foreground="#8E1B1B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Componentes" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtFonte" Foreground="#5E5E5C" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Projeto" Style="{DynamicResource Rotulo}"/>
                    <ComboBox x:Name="cbProjeto" Width="280" SelectionChanged="projeto_mudou"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Dados do sistema" Style="{DynamicResource Rotulo}"/>
                    <ComboBox x:Name="cbFonte" Width="160" SelectionChanged="fonte_mudou">
                        <ComboBoxItem Content="Oficial"/>
                        <ComboBoxItem Content="Desenvolvimento"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,14,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- esquerda: família e tipos -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{DynamicResource Cartao}" Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="1 · Família e tipos" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="tbArquivo" IsReadOnly="True" ToolTip="Arquivo .rfa ou família já inserida no modelo"/>
                            <Button Grid.Column="1" Content="Escolher arquivo…" Margin="8,0,0,0" Padding="14,0" Click="escolher" ToolTip="Carregar uma família nova (.rfa)"/>
                            <Button Grid.Column="2" Content="Selecionar no modelo" Margin="8,0,0,0" Padding="14,0" Click="selecionar" ToolTip="Readequar uma família já inserida: clique num elemento"/>
                        </Grid>
                        <TextBlock x:Name="txtFamilia" Grid.Row="2" Foreground="#5E5E5C" Margin="0,8,0,0" TextWrapping="Wrap" Text="Escolha um arquivo .rfa (família nova) ou selecione no modelo um elemento já inserido (readequar)."/>
                        <Grid x:Name="gCab" Grid.Row="3" Margin="4,10,4,4"/>
                        <ListBox x:Name="lbTipos" Grid.Row="4" SelectionMode="Extended" SelectionChanged="tipos_selecionados" BorderBrush="#E2E2DF" BorderThickness="1" MinHeight="160"/>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Selecionar todos" Padding="12,0" Style="{DynamicResource Discreto}" Click="selecionar_todos"/>
                            <TextBlock x:Name="txtSelTipos" Foreground="#5E5E5C" VerticalAlignment="Center" Margin="12,0,0,0" Text="Ctrl ou Shift para selecionar vários tipos"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. no modelo -->
                <Border Grid.Row="1" Style="{DynamicResource Cartao}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="3 · No modelo" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ckRenomear" Content="Renomear a família como (SIGLA) DESCRIÇÃO" IsChecked="True" Click="renomear_mudou"/>
                        <TextBox x:Name="tbNomeFam" Margin="22,6,0,0" TextChanged="nome_mudou" ToolTip="Nome da família no modelo"/>
                        <CheckBox x:Name="ckRenomearTipos" Content="Renomear os tipos como KEYNOTE - DESCRIÇÃO" IsChecked="False" Margin="0,10,0,0" Click="renomear_mudou"
                                  ToolTip="Se vários tipos usam o mesmo código, o nome original do tipo vai no fim para não repetir"/>
                        <TextBlock x:Name="txtPrevia" Foreground="#5E5E5C" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtAvisos" Foreground="#8A5D05" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtProblemas" Foreground="#B3261E" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- direita: código para os tipos selecionados -->
            <Border Grid.Column="2" Style="{DynamicResource Cartao}" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="2 · Código dos tipos selecionados" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="txtAlvo" Foreground="#5E5E5C" Margin="0,2,0,8" TextWrapping="Wrap" Text="Selecione um ou mais tipos na lista."/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="rbExistente" Content="Código existente" IsChecked="True" Margin="0,0,18,0" Checked="modo_mudou"/>
                        <RadioButton x:Name="rbNovo" Content="Código novo" Checked="modo_mudou"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid x:Name="spExistente">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="tbBusca" TextChanged="busca_mudou" ToolTip="FJ, keynote, sigla ou descrição" Margin="0,0,0,6"/>
                            <ListBox x:Name="lbItens" Grid.Row="1" BorderBrush="#E2E2DF" BorderThickness="1"/>
                        </Grid>
                        <StackPanel x:Name="gNovo" Visibility="Collapsed">
                            <TextBlock Text="Sigla (elemento/família)" Style="{DynamicResource Rotulo}"/>
                            <ComboBox x:Name="cbSigla" SelectionChanged="sigla_mudou"/>
                            <TextBlock Text="Descrição simplificada (texto do keynote)" Style="{DynamicResource Rotulo}" Margin="0,10,0,0"/>
                            <TextBox x:Name="tbDesc"/>
                            <TextBlock Text="Especificação (opcional)" Style="{DynamicResource Rotulo}" Margin="0,10,0,0"/>
                            <TextBox x:Name="tbTexto" Height="90" Padding="8,6" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Foreground="#5E5E5C" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Tipos que recebem o mesmo código novo de uma vez compartilham o mesmo item (e o mesmo keynote)."/>
                        </StackPanel>
                    </Grid>
                    <Button x:Name="btAplicarCod" Grid.Row="3" Content="Aplicar aos tipos selecionados" Margin="0,10,0,0" Height="34" Style="{DynamicResource Primario}" IsEnabled="False" Click="aplicar_codigo"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E2DF" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtRodape" Foreground="#5E5E5C" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Fechar" Margin="0,0,8,0" Padding="16,0" Style="{DynamicResource Discreto}" Click="fechar"/>
                <Button x:Name="btInserir" Grid.Column="2" Content="Gravar no modelo" Padding="18,0" Style="{DynamicResource Primario}" IsEnabled="False" Click="inserir"/>
            </Grid>
        </Border>
    </Grid>
</Window>
