<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Componentes — Ferramentas FJA" Width="980" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#F6F6F5" Foreground="#1D1D1D">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- cabeçalho no padrão do sistema -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E2DF" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" BorderBrush="#C9C9C5" BorderThickness="1" Background="White" VerticalAlignment="Center">
                    <TextBlock Text="FJ" FontFamily="Arial" FontWeight="Bold" FontSize="15" Foreground="#8E1B1B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Componentes" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtFonte" Foreground="#5E5E5C" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Projeto" Style="{DynamicResource Rotulo}"/>
                    <ComboBox x:Name="cbProjeto" Width="280" SelectionChanged="projeto_mudou"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Dados do sistema" Style="{DynamicResource Rotulo}"/>
                    <ComboBox x:Name="cbFonte" Width="160" SelectionChanged="fonte_mudou">
                        <ComboBoxItem Content="Oficial"/>
                        <ComboBoxItem Content="Desenvolvimento"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,14,18,8">
                <!-- 1. família -->
                <Border Style="{DynamicResource Cartao}" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1 · Família" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="tbArquivo" IsReadOnly="True" ToolTip="Arquivo .rfa ou família já inserida no modelo"/>
                            <Button Grid.Column="1" Content="Escolher arquivo…" Margin="8,0,0,0" Padding="14,0" Click="escolher" ToolTip="Carregar uma família nova (.rfa)"/>
                            <Button Grid.Column="2" Content="Selecionar no modelo" Margin="8,0,0,0" Padding="14,0" Click="selecionar" ToolTip="Readequar uma família já inserida: clique num elemento"/>
                        </Grid>
                        <TextBlock x:Name="txtFamilia" Foreground="#5E5E5C" Margin="0,8,0,0" TextWrapping="Wrap" Text="Escolha um arquivo .rfa (família nova) ou selecione no modelo um elemento já inserido (readequar)."/>
                        <TextBlock x:Name="txtVinculo" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <StackPanel x:Name="spAbr" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="Aplicar em:" Foreground="#5E5E5C" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton x:Name="rbFamilia" IsChecked="True" Margin="0,0,18,0" VerticalAlignment="Center" Checked="abr_mudou"/>
                            <RadioButton x:Name="rbTipo" VerticalAlignment="Center" Checked="abr_mudou"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. código -->
                <Border Style="{DynamicResource Cartao}" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="2 · Código da biblioteca" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="rbExistente" Content="Usar um código existente" IsChecked="True" Margin="0,0,18,0" Checked="modo_mudou"/>
                            <RadioButton x:Name="rbNovo" Content="Criar um código novo" Checked="modo_mudou"/>
                        </StackPanel>
                        <StackPanel x:Name="spExistente">
                            <TextBox x:Name="tbBusca" TextChanged="busca_mudou" ToolTip="FJ, keynote, sigla ou descrição" Margin="0,0,0,6"/>
                            <ListBox x:Name="lbItens" Height="220" SelectionChanged="item_mudou" BorderBrush="#E2E2DF" BorderThickness="1"/>
                        </StackPanel>
                        <Grid x:Name="gNovo" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Sigla (elemento/família)" Style="{DynamicResource Rotulo}"/>
                                <ComboBox x:Name="cbSigla" SelectionChanged="novo_mudou"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Descrição simplificada (texto do keynote)" Style="{DynamicResource Rotulo}"/>
                                <TextBox x:Name="tbDesc" TextChanged="novo_mudou"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                <TextBlock Text="Especificação (opcional)" Style="{DynamicResource Rotulo}"/>
                                <TextBox x:Name="tbTexto" Height="64" Padding="8,6" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. família no modelo -->
                <Border Style="{DynamicResource Cartao}" Padding="16,12" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="3 · No modelo" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ckRenomear" Content="Renomear a família como (SIGLA) DESCRIÇÃO" IsChecked="True" Click="renomear_mudou"/>
                        <TextBox x:Name="tbNomeFam" Margin="0,6,0,0" TextChanged="nome_mudou" ToolTip="Nome da família no modelo"/>
                        <TextBlock x:Name="txtPrevia" Foreground="#5E5E5C" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtAvisos" Foreground="#8A5D05" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtProblemas" Foreground="#B3261E" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E2DF" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtRodape" Foreground="#5E5E5C" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Fechar" Margin="0,0,8,0" Padding="16,0" Style="{DynamicResource Discreto}" Click="fechar"/>
                <Button x:Name="btInserir" Grid.Column="2" Content="Inserir no modelo" Padding="18,0" Style="{DynamicResource Primario}" IsEnabled="False" Click="inserir"/>
            </Grid>
        </Border>
    </Grid>
</Window>
