<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Legenda LOG · prévia" Width="1320" Height="800" MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="560"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ajustes -->
    <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{DynamicResource Cartao}" Padding="14,10" Margin="0,0,0,12">
      <WrapPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
          <TextBlock Text="Altura mínima da linha" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Slider x:Name="slPasso" Width="140" Minimum="4" Maximum="14" Value="6.7" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
          <TextBlock x:Name="txtPasso" Width="56" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
          <TextBlock Text="Largura da legenda" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="txtLargura" Width="54" Text="17,5" VerticalAlignment="Center" Padding="4,2" HorizontalContentAlignment="Right"/>
          <TextBlock Text="cm" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
          <TextBlock Text="Cor dos símbolos" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Border x:Name="swCor" Width="18" Height="18" CornerRadius="3" BorderBrush="#9a9a96" BorderThickness="1" Background="Black" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="cbCor" Width="220" VerticalAlignment="Center">
            <ComboBoxItem Content="Cor do modelo (como nas vistas)"/>
            <ComboBoxItem Content="Cor do projeto no Sistema FJA"/>
            <ComboBoxItem Content="Escolher cor…"/>
            <ComboBoxItem Content="Preto"/>
          </ComboBox>
        </StackPanel>
        <CheckBox x:Name="chkLinhasH" Content="Linhas entre itens" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <CheckBox x:Name="chkLinhaV" Content="Linha entre símbolo e texto" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <CheckBox x:Name="chkMargens" Content="Margens (contorno)" VerticalAlignment="Center" Margin="0,0,24,0"/>
        <Button x:Name="btAtualizar" Content="Atualizar prévia" Padding="14,5" VerticalAlignment="Center"/>
      </WrapPanel>
    </Border>

    <!-- itens -->
    <Border Grid.Row="1" Grid.Column="0" Style="{DynamicResource Cartao}" Padding="0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{DynamicResource Linha}" BorderThickness="0,0,0,1">
          <DockPanel>
            <Button x:Name="btTodos100" DockPanel.Dock="Right" Content="Voltar todos a 100%" Padding="10,3" Style="{DynamicResource Discreto}"/>
            <TextBlock x:Name="txtItens" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="14,6" Background="{DynamicResource Lateral}">
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Suave}" FontSize="12"
                     Text="Marque os itens e ajuste o texto. A escala de cada símbolo vai de 25% a 300% (100% = como aparece na prancha): ao mexer, a prévia mostra uma caixa vermelha no tamanho novo; Atualizar prévia refaz os símbolos que mudaram. A medida é a do símbolo no papel."/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="lista" Margin="6,4"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- prévia -->
    <Border Grid.Row="1" Grid.Column="2" Style="{DynamicResource Cartao}" Padding="0">
      <Grid>
        <Grid x:Name="hostPrev" Background="White"/>
        <TextBlock x:Name="txtPrevVazia" Text="Gerando a prévia…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Fraco}"/>
      </Grid>
    </Border>

    <!-- rodapé -->
    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="btCancelar" Content="Cancelar" Padding="16,6" Margin="0,0,8,0" Style="{DynamicResource Discreto}"/>
        <Button x:Name="btGerar" Content="Gerar legenda" Padding="18,6" Style="{DynamicResource Primario}"/>
      </StackPanel>
      <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Foreground="{DynamicResource Suave}" TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</Window>
